# Runtime safety mode. DEMO_SANDBOX is the fail-closed default.
AUVRA_RUNTIME_MODE=DEMO_SANDBOX

# Current public catalog API. Authentication is not required for discovery.
NEAR_MARKET_BASE_URL=https://market.near.ai

# Worker-only buyer account binding and independent AES-256-GCM key (32 random bytes, base64url).
# OAuth credentials are encrypted in Postgres; never place bearer/refresh tokens here.
# Keep the same key in the worker environment across restarts. Losing it requires re-enrollment.
NEAR_MARKET_BUYER_ACCOUNT_ID=
NEAR_MARKET_CREDENTIAL_KEY=

# Read-only listing filter used by the connectivity probe.
AUVRA_MARKET_CATEGORY=research

# Paid buyer actions will use OAuth/MCP. They are not implemented yet.
MARKETPLACE_WRITES_ENABLED=false
MARKETPLACE_MAX_SPEND_MINOR=0

# Local infrastructure. S3Mock uses the same S3 API as the deployed private bucket.
DATABASE_URL=postgresql://auvra:auvra_local@localhost:55432/auvra?schema=public
REDIS_URL=redis://localhost:6379
# M7 queue workers are opt-in; review existing outbox backlog before enabling.
AUVRA_M7_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=auvra-local
S3_ACCESS_KEY=auvra_local
S3_SECRET_KEY=auvra_local_secret

# Auth.js / Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Bachs USD checkout. Use sk_sandbox_ with DEMO_SANDBOX, sk_live_ with LIVE_MARKET.
# Never use sandbox receipts for live marketplace spending.
BACHS_USD_ENABLED=false
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=

# Worker-only NEAR receipt signer. Leave unset until an authorized network deployment.
NEAR_RECEIPT_NETWORK=testnet
NEAR_RECEIPT_CONTRACT_ACCOUNT=
NEAR_RECEIPT_SIGNER_ACCOUNT=
NEAR_RECEIPT_SIGNER_PRIVATE_KEY=
