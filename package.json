{
  "name": "auvra",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:web": "node scripts/ensure-local-db.mjs && pnpm --filter @auvra/web dev",
    "build:web": "pnpm --filter @auvra/web build",
    "check:web": "pnpm --filter @auvra/web check",
    "verify:local": "node apps/web/scripts/verify-local-flow.mjs",
    "format": "prettier --write \"{apps/web,apps/worker,src,packages,scripts,tests}/**/*.{ts,tsx,mjs,css,json}\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"{apps/web,apps/worker,src,packages,scripts,tests}/**/*.{ts,tsx,mjs,css,json}\" \"*.{ts,json}\"",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "market:list": "tsx src/marketplace/list-services.ts",
    "market:connect": "tsx src/marketplace/connect-buyer.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.2.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@types/node": "24.10.1",
    "bullmq": "5.81.5",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.4"
  }
}
